# MyScripts Workspace — Environment Variables
# Copy to .env.local and fill in values (never commit .env.local).
# All variables are optional unless marked required.
#
# Sub-projects each have their own .env.example — this file covers
# workspace-level and shared tooling variables only.

# ── GitHub / CI ────────────────────────────────────────────────────────────
# Personal access token for gh CLI (use keyring-based auth instead when possible)
# GH_TOKEN=

# ── Playwright ─────────────────────────────────────────────────────────────
# Shared Playwright browsers directory (avoids downloading per sub-project)
# PLAYWRIGHT_BROWSERS_PATH=C:\Users\ryair\AppData\Local\ms-playwright

# ── Dev cache redirects ────────────────────────────────────────────────────
# Redirect heavy dev caches to a shared parent directory.
# Useful to avoid duplicating large caches across sibling sub-projects.
# PLAYWRIGHT_BROWSERS_PATH=../cache/playwright
# npm_config_cache=../cache/npm

# ── Python ─────────────────────────────────────────────────────────────────
# Override Python executable (e.g. for testing with a specific version)
# PYTHON=python3.12

# ── Proxy (corporate) ──────────────────────────────────────────────────────
# Set if you're behind a corporate proxy (values come from env or keyring — never hardcode)
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# ── MCP Servers ────────────────────────────────────────────────────────────
# Cloudflare Workers / Pages (only needed for Cloudflare MCP server)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ── Telemetry ──────────────────────────────────────────────────────────────
# Set to 1 to disable telemetry for various tools
# DO_NOT_TRACK=1
# NEXT_TELEMETRY_DISABLED=1
