# Shared npmrc for projects under MyScripts/
# Enforce Node engine declared in package.json to prevent silent upgrades.
engine-strict=true

# Lock to exact installed versions for reproducible installs.
save-exact=true

# Use OS-level temp for npm cache so per-project lock-state can't leak between
# sibling projects in MyScripts/.
# (npm honours XDG_CACHE_HOME on Unix; on Windows it uses %LOCALAPPDATA%/npm-cache.)
fund=false
audit-level=high
