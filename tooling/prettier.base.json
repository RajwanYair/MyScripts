{
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.json", "*.jsonc"],
            "options": { "trailingComma": "none" }
        },
        {
            "files": ["*.md"],
            "options": { "printWidth": 120, "proseWrap": "preserve" }
        }
    ]
}
