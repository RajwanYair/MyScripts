{
    // ============================================================================
    // TASKS — Generic Templates
    // Universal Project Enhancement Framework v15.0.0
    // ============================================================================
    "version": "2.0.0",
    "tasks": [
        // ============================================================================
        // PYTHON — Generic Run Tasks
        // ============================================================================
        {
            "label": "Python: Run Current File",
            "detail": "Run the currently open Python file with python ${file}",
            "type": "shell",
            "command": "python",
            "args": ["${file}"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Python: Run with Arguments",
            "detail": "Run the current Python file with custom arguments (prompted)",
            "type": "shell",
            "command": "python",
            "args": ["${file}", "${input:args}"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        // ============================================================================
        // PYTHON — Testing Tasks
        // ============================================================================
        {
            "label": "Test: Run All Tests",
            "detail": "Run all pytest tests with verbose output and short tracebacks",
            "type": "shell",
            "command": "python",
            "args": ["-m", "pytest", "tests/", "-v", "--tb=short"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Test: Run with Coverage",
            "detail": "Run tests with HTML coverage report (output in $TEMP)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests/",
                "-v",
                "--cov=src",
                "--cov-report=term-missing",
                "--cov-report=html"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Test: Run Current File",
            "type": "shell",
            "command": "python",
            "args": ["-m", "pytest", "${file}", "-v", "--tb=short"],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        // ============================================================================
        // PYTHON — Linting & Formatting
        // ============================================================================
        {
            "label": "Lint: Run Ruff",
            "detail": "Lint src/ and tests/ with ruff — replaces flake8/isort",
            "type": "shell",
            "command": "python",
            "args": ["-m", "ruff", "check", "src/", "tests/"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Lint: Run Flake8",
            "type": "shell",
            "command": "python",
            "args": ["-m", "flake8", "src/", "--max-line-length=100"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "python",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+): (\\w+) (.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "code": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Format: Run Ruff",
            "detail": "Auto-format src/ and tests/ with ruff format — replaces Black",
            "type": "shell",
            "command": "python",
            "args": ["-m", "ruff", "format", "src/", "tests/"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Format: Run Black",
            "type": "shell",
            "command": "python",
            "args": ["-m", "black", "src/", "tests/", "--line-length=100"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Type Check: Run MyPy",
            "detail": "Run mypy static type analysis on src/",
            "type": "shell",
            "command": "python",
            "args": ["-m", "mypy", "src/", "--ignore-missing-imports"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Security: Run Bandit",
            "type": "shell",
            "command": "python",
            "args": ["-m", "bandit", "-r", "src/", "-ll"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // ============================================================================
        // PYTHON — Installation
        // ============================================================================
        {
            "label": "Install: Requirements",
            "type": "shell",
            "command": "pip",
            "args": ["install", "-r", "requirements.txt"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Install: Dev Requirements",
            "type": "shell",
            "command": "pip",
            "args": [
                "install",
                "pytest",
                "pytest-cov",
                "pytest-asyncio",
                "black",
                "flake8",
                "mypy",
                "bandit",
                "isort",
                "ruff"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Install: Editable (dev)",
            "type": "shell",
            "command": "pip",
            "args": ["install", "-e", ".[dev]"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        // ============================================================================
        // PYTHON — Documentation
        // ============================================================================
        {
            "label": "Docs: Serve MkDocs",
            "type": "shell",
            "command": "python",
            "args": ["-m", "mkdocs", "serve"],
            "group": "build",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Docs: Build MkDocs",
            "type": "shell",
            "command": "python",
            "args": ["-m", "mkdocs", "build"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        // ============================================================================
        // PYTHON — Quality Assurance
        // ============================================================================
        {
            "label": "QA: Full Check",
            "detail": "Sequential full quality gate: format → lint → typecheck → security → tests",
            "dependsOn": [
                "Format: Run Black",
                "Lint: Run Flake8",
                "Type Check: Run MyPy",
                "Security: Run Bandit",
                "Test: Run All Tests"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        // ============================================================================
        // WORKSPACE — Maintenance
        // ============================================================================
        {
            "label": "Clean: TEMP artifacts",
            "detail": "Remove all intermediate build artifacts from TEMP for the current project",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "if (Test-Path \"$env:TEMP\\${workspaceFolderBasename}\") { Remove-Item -Recurse -Force \"$env:TEMP\\${workspaceFolderBasename}\"; Write-Host 'Cleaned: ' + \"$env:TEMP\\${workspaceFolderBasename}\" } else { Write-Host 'Nothing to clean.' }"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "args",
            "description": "Command line arguments",
            "type": "promptString",
            "default": ""
        }
    ]
}
