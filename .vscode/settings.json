    "trailing-spaces.backgroundColor": "rgba(255,0,0,0.1)",
    "trailing-spaces.includeEmptyLines": false,
    // ============================================================================
    // SECTION: vscode-edge-devtools — Edge DevTools
    // ============================================================================
    "vscode-edge-devtools.webhint": false,
    // ============================================================================
    // SECTION: vsicons — VSCode Icons
    // ============================================================================
    "vsicons.dontShowNewVersionMessage": true,
    // ============================================================================
    // SECTION: workbench — Workbench Configuration
    // ============================================================================
    "workbench.colorCustomizations": {
        "editor.selectionHighlightBorder": "#A9A9A9",
        "editor.wordHighlightBorder": "#FFD700",
        "editor.wordHighlightStrongBorder": "#FF6347",
        "[Default Dark Modern]": {
            "tab.activeBorderTop": "#00FF00",
            "tab.unfocusedActiveBorderTop": "#00FF0088",
            "textCodeBlock.background": "#00000055"
        }
    },
    "workbench.editor.enablePreview": true,
    "workbench.editor.revealIfOpen": true,
    "workbench.iconTheme": "vscode-icons",
    "workbench.startupEditor": "none",
    "workbench.view.alwaysShowHeaderActions": true,
    // ============================================================================
    // SECTION: xml — XML Extension
    // ============================================================================
    "xml.server.binary.trustedHashes": [
        "0fa2a471cccced39068dbb7f738d4f527557ebd3d35db4cb48501bbd68f1a74a"
    ],
    // ============================================================================
    // SECTION: yaml — YAML Extension
    // ============================================================================
    "yaml.schemas": {
        "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
    },
    // ============================================================================
    // SECTION: Language-Specific Overrides (alphabetical)
    // ============================================================================
    "[bat]": {
        "files.eol": "\r\n"
    },
    "[buildconfig]": {
        "editor.formatOnType": true,
        "editor.quickSuggestions": {
            "comments": "off",
            "other": "off",
            "strings": "off"
        }
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
    },
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
    },
    "[e]": {
        "editor.formatOnType": true,
        "editor.quickSuggestions": {
            "comments": "off",
            "other": "off",
            "strings": "off"
        }
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
        "editor.quickSuggestions": {
            "comments": false,
            "other": true,
            "strings": true
        },
        "editor.wordWrap": "on",
        "files.trimTrailingWhitespace": false
    },
    "[powershell]": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
    },
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        },
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
    },
    "[shellscript]": {
        "editor.formatOnSave": false,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
    },
    "[systemverilog]": {
        "editor.formatOnType": true,
        "editor.quickSuggestions": {
            "comments": "off",
            "other": "off",
            "strings": "off"
        }
    },
    "[vhdl]": {
        "editor.formatOnType": true,
        "editor.quickSuggestions": {
            "comments": "off",
            "other": "off",
            "strings": "off"
        }
    },
    "[xml]": {
        "editor.formatOnPaste": false,
        "editor.formatOnSave": false
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    }
}
