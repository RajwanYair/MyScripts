{
    "name": "myscripts-shared",
    "version": "1.1.0",
    "private": true,
    "description": "Shared node_modules for all JS/TS projects under MyScripts/. Run `npm install` here — never inside sub-projects.",
    "workspaces": [
        "WoodworkingShop"
    ],
    "engines": {
        "node": ">=22.13.0 || >=24.0.0 || >=26.0.0"
    },
    "browserslist": [
        "last 2 Chrome versions",
        "last 2 Firefox versions",
        "last 2 Safari versions",
        "last 2 Edge versions",
        "not dead",
        "not ie 11",
        "not ie_mob 11"
    ],
    "scripts": {
        "lint:tooling": "eslint tooling/eslint/ --max-warnings 0 --ext .mjs",
        "lint:md": "markdownlint-cli2 \"*.md\" \"docs/**/*.md\" \".github/*.md\" \".github/instructions/*.md\" \".github/prompts/*.md\" --config .markdownlint.json",
        "validate:scripts": "node --check scripts/validate-mermaid.mjs && node --check scripts/check-bundle-size.mjs && node --check scripts/check-test-focus-skip.mjs && node --check scripts/check-hub-links.mjs && node --check scripts/parallel-quality.mjs && node --check scripts/check-owasp.mjs && node --check scripts/sbom.mjs && node --check scripts/arch-check.mjs",
        "validate:json": "node -e \"['tooling/htmlhint/base.json','tooling/markdownlint.base.json','tooling/stylelint/base.json','templates/bundle-budget.template.json'].forEach(f=>{try{JSON.parse(require('fs').readFileSync(f,'utf8'));console.log('OK:',f)}catch(e){console.error('FAIL:',f,e.message);process.exit(1)}})\"",
        "check": "npm run lint:md && npm run validate:json && npm run validate:scripts",
        "sbom": "node scripts/sbom.mjs"
    },
    "dependencies": {
        "@preact/signals-core": "^1.14.2",
        "@react-pdf/renderer": "^4.5.1",
        "@supabase/supabase-js": "^2.106.2",
        "dompurify": "^3.4.5",
        "i18next": "^26.2.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-i18next": "^17.0.8",
        "valibot": "^1.4.1",
        "zod": "^4.4.3",
        "zustand": "^5.0.13"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.3",
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@cyclonedx/cyclonedx-npm": "^4.2.1",
        "@eslint/js": "^10.0.1",
        "@lhci/cli": "^0.15.1",
        "@playwright/test": "^1.60.0",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@tailwindcss/vite": "^4.3.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^22.15.0",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/browser": "^5.0.2",
        "@vitest/browser-playwright": "^5.0.2",
        "@vitest/coverage-v8": "^5.0.2",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-compat": "^7.0.2",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jsdoc": "^64.5.4",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-no-only-tests": "^3.3.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-regexp": "^3.3.1",
        "eslint-plugin-testing-library": "^7.3.0",
        "fast-check": "^4.8.0",
        "globals": "^17.6.0",
        "happy-dom": "^20.9.0",
        "htmlhint": "^1.9.2",
        "https-proxy-agent": "^9.0.0",
        "jsdom": "^29.1.1",
        "knip": "^5.56.0",
        "lint-staged": "^17.0.5",
        "markdownlint-cli2": "^0.22.1",
        "playwright": "^1.60.0",
        "prettier": "^3.9.9",
        "rimraf": "^6.0.1",
        "serve": "^14.2.6",
        "simple-git-hooks": "^2.13.1",
        "stylelint": "^17.12.0",
        "stylelint-config-standard": "^40.0.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.1",
        "vitest": "^5.0.2",
        "web-push": "^3.6.7"
    },
    "overrides": {
        "eslint-plugin-jsx-a11y": {
            "eslint": "^10.0.0"
        },
        "eslint-plugin-react": {
            "eslint": "*"
        },
        "uuid": ">=11.1.1"
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged",
        "commit-msg": "npx --no-install commitlint --edit \"$1\""
    },
    "lint-staged": {
        "*.md": "markdownlint-cli2 --config .markdownlint.json"
    },
    "knip": {
        "entry": [
            "scripts/*.mjs",
            "tooling/**/*.mjs"
        ],
        "project": [
            "scripts/**/*.{mjs,js}",
            "tooling/**/*.{mjs,js,mts}"
        ],
        "ignore": [
            "templates/**"
        ]
    }
}
